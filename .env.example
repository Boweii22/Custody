# Default: fictional, durable demo. Browser requests cannot switch the rail.
CUSTODY_RAIL=demo
# Required before CUSTODY_RAIL=sandbox. Exact Sites authenticated user ID.
CUSTODY_SELLER_ID=
# SANDBOX credentials only; the adapter has no production API origin.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional HTTPS OpenAI-compatible chat-completions endpoint, strict JSON schema.
# All model output is relabeled tainted:model and has no tool access.
EXTRACTOR_URL=
EXTRACTOR_KEY=
EXTRACTOR_MODEL=
