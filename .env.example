# No rail is active until explicitly configured. Never use production credentials.
CUSTODY_RAIL=
# Exact hosted Sites authenticated user ID. Local development cannot move funds.
CUSTODY_SELLER_ID=
# Genuine PayPal SANDBOX app credentials, stored as server secrets.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional; authenticated reconciliation works without inbound webhooks.
PAYPAL_WEBHOOK_ID=
# Required HTTPS OpenAI-compatible chat-completions endpoint with strict JSON schema.
# No deterministic parser, fake response, or fallback exists in the real path.
EXTRACTOR_URL=
EXTRACTOR_KEY=
EXTRACTOR_MODEL=
